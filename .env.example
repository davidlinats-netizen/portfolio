# Server-only. Never prefix a secret with NEXT_PUBLIC_.
# Groq is provisional; configure the provider/model you confirm.
AI_PROVIDER=groq
# Optional public contact URL. Set before building; omit to use Calendly.
NEXT_PUBLIC_WHATSAPP_URL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Local, single-process usage limits (reset when the server restarts).
CHAT_REQUESTS_PER_MINUTE=10
CHAT_REQUESTS_PER_DAY=100
